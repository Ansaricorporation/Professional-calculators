---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchModal from '../components/SearchModal.astro';
import { SITE_CONFIG } from '../config/site';
import { getPath, getCanonicalUrl } from '../utils/paths';

interface Props {
  title: string;
  metaTitle?: string;
  description?: string;
  canonicalPath?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  softwareAppSchema?: Record<string, any>;
  faqSchema?: Record<string, any>;
  lastUpdated?: string;
}

const {
  title,
  metaTitle,
  description = SITE_CONFIG.description,
  canonicalPath = '',
  ogType = 'website',
  ogImage,
  softwareAppSchema,
  faqSchema,
  lastUpdated = '2026-11'
} = Astro.props;

const pageTitle = metaTitle ? `${metaTitle} | ${SITE_CONFIG.siteName}` : `${title} | ${SITE_CONFIG.siteName}`;
const fullCanonicalUrl = getCanonicalUrl(canonicalPath || Astro.url.pathname, SITE_CONFIG.siteUrl);
const fullSiteUrl = getCanonicalUrl('/', SITE_CONFIG.siteUrl);
const defaultOgUrl = getCanonicalUrl('/og/default.png', SITE_CONFIG.siteUrl);
const effectiveOgImage = ogImage || defaultOgUrl;

// Base Organization & WebSite JSON-LD
const siteSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${fullSiteUrl}#organization`,
      "name": SITE_CONFIG.siteName,
      "url": fullSiteUrl,
      "logo": getCanonicalUrl('/favicon.svg', SITE_CONFIG.siteUrl),
      "description": SITE_CONFIG.description,
      "email": SITE_CONFIG.contactEmail,
      "sameAs": [
        "https://twitter.com/creatorcalclab",
        "https://github.com/creatorcalclab"
      ]
    },
    {
      "@type": "WebSite",
      "@id": `${fullSiteUrl}#website`,
      "url": fullSiteUrl,
      "name": SITE_CONFIG.siteName,
      "description": SITE_CONFIG.description,
      "publisher": { "@id": `${fullSiteUrl}#organization` },
      "inLanguage": "en-US"
    }
  ]
};
---

<!doctype html>
<html lang="en" class="h-full bg-slate-50 text-slate-900 scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={getPath('/favicon.svg')} />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{pageTitle}</title>
    <meta name="title" content={pageTitle} />
    <meta name="description" content={description} />
    <link rel="canonical" href={fullCanonicalUrl} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={fullCanonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={SITE_CONFIG.siteName} />
    <meta property="og:image" content={effectiveOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={fullCanonicalUrl} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={effectiveOgImage} />

    <!-- Typography Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />

    <!-- Base WebSite & Organization JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(siteSchema)} />

    <!-- SoftwareApplication JSON-LD (Calculators) -->
    {softwareAppSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(softwareAppSchema)} />
    )}

    <!-- FAQPage JSON-LD -->
    {faqSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    )}
  </head>
  <body class="min-h-full flex flex-col font-sans antialiased text-slate-900 bg-slate-50 selection:bg-emerald-500 selection:text-white">
    <!-- Header -->
    <Header currentPath={Astro.url.pathname} />

    <!-- AdSense Top Banner Slot (Zero-CLS Graceful Collapse) -->
    <aside
      id="adsense-top-banner"
      class="adsense-container w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 empty:hidden min-h-0 transition-all overflow-hidden"
      aria-label="Advertisement"
    >
      <!-- AdSense Top Banner Slot -->
    </aside>

    <!-- Main Content Slot -->
    <main class="flex-1 w-full">
      <slot />
    </main>

    <!-- AdSense In-Content / Bottom Slot (Zero-CLS Graceful Collapse) -->
    <aside
      id="adsense-incontent-slot"
      class="adsense-container w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 empty:hidden min-h-0 transition-all overflow-hidden my-4"
      aria-label="Advertisement"
    >
      <!-- AdSense In-Content Slot -->
    </aside>

    <!-- Footer -->
    <Footer />

    <!-- Global Search Modal -->
    <SearchModal />
  </body>
</html>
