---
import type { CalculatorDefinition } from '../../data/schema';

interface Props {
  calc: CalculatorDefinition;
}

const { calc } = Astro.props;
const d = calc.defaultInputs as {
  actualWeightLbs?: number;
  lengthInches?: number;
  widthInches?: number;
  heightInches?: number;
  dimDivisor?: number;
  packagingCost?: number;
  handlingCost?: number;
  shippingCharged?: number;
  productPrice?: number;
  targetMargin?: number;
  carrierPreset?: string;
};

// Static pre-rendered calculations
const preActualLbs = Number(d.actualWeightLbs) || 2.5;
const preL = Number(d.lengthInches) || 12.0;
const preW = Number(d.widthInches) || 10.0;
const preH = Number(d.heightInches) || 6.0;
const preDivisor = Number(d.dimDivisor) || 166;
const preBoxCost = Number(d.packagingCost) || 1.25;
const preHandling = Number(d.handlingCost) || 1.50;
const preShipCharged = Number(d.shippingCharged) || 0.0;
const prePrice = Number(d.productPrice) || 75.0;
const preTargetMargin = Number(d.targetMargin) || 40.0;
const preCarrier = d.carrierPreset || 'usps-ground';

const preCubicInches = preL * preW * preH;
const preDimWeight = (preCubicInches / preDivisor);
const preBillableWeight = Math.max(preActualLbs, preDimWeight);
const preIsDimPenalty = preDimWeight > preActualLbs;

// Standard 2026 Commercial Rate Schedule Approximations
const carrierRates: Record<string, { base: number; perLb: number; name: string }> = {
  'usps-ground': { base: 6.85, perLb: 0.95, name: 'USPS Ground Advantage (Commercial)' },
  'usps-priority': { base: 9.40, perLb: 1.45, name: 'USPS Priority Mail (Commercial)' },
  'ups-ground': { base: 9.80, perLb: 1.20, name: 'UPS Ground (Commercial)' },
  'fedex-ground': { base: 10.20, perLb: 1.25, name: 'FedEx Home Delivery (Commercial)' }
};

const cRate = carrierRates[preCarrier] || carrierRates['usps-ground'];
const prePostageCost = cRate.base + (Math.max(0, preBillableWeight - 1) * cRate.perLb);
const preTotalFulfillment = prePostageCost + preBoxCost + preHandling;
const preFulfillmentDeficit = Math.max(0, preTotalFulfillment - preShipCharged);
const preMarginErosionPct = prePrice > 0 ? (preFulfillmentDeficit / prePrice) * 100 : 0;
const preRecommendedShipping = preTotalFulfillment;
const preFreeShipAov = preTotalFulfillment / (preTargetMargin / 100);

// Stacked Bar
const preGross = prePrice + preShipCharged;
const preNetAfterShip = Math.max(0, prePrice - preTotalFulfillment);
const preNetPct = preGross > 0 ? (preNetAfterShip / preGross) * 100 : 50;
const prePostagePct = preGross > 0 ? (prePostageCost / preGross) * 100 : 25;
const prePackagingPct = preGross > 0 ? ((preBoxCost + preHandling) / preGross) * 100 : 15;
const preDeficitPct = Math.max(0, 100 - preNetPct - prePostagePct - prePackagingPct);
---

<div class="bg-white rounded-2xl border border-slate-200 shadow-md overflow-hidden" id="engine-shipping-cost">
  <!-- Top Engine Header -->
  <div class="bg-slate-900 text-white px-6 py-4 flex flex-wrap items-center justify-between gap-3">
    <div class="flex items-center space-x-2">
      <span class="w-3 h-3 rounded-full bg-emerald-400"></span>
      <h2 class="text-base font-bold tracking-wide">Dimensional Weight (DIM) & Landed Shipping Engine</h2>
    </div>
    <div class="flex items-center space-x-3 text-xs">
      <button
        type="button"
        id="sc-share-btn"
        class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 transition-colors"
      >
        <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/></svg>
        <span id="sc-share-text">Share Link</span>
      </button>

      <button
        type="button"
        id="sc-export-btn"
        class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 transition-colors"
      >
        <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
        <span id="sc-export-text">Copy Receipt</span>
      </button>

      <button
        type="button"
        id="sc-reset-btn"
        class="text-xs text-emerald-400 hover:text-emerald-300 font-medium underline underline-offset-2 ml-1"
      >
        Reset Defaults
      </button>
    </div>
  </div>

  <!-- DIM Weight Surcharge Alert Banner -->
  <div id="sc-dim-banner" class={`px-6 py-3.5 border-b flex items-center justify-between gap-3 text-xs ${
    preIsDimPenalty
      ? 'bg-amber-500/10 border-amber-300 text-amber-950'
      : 'bg-emerald-500/10 border-emerald-300 text-emerald-950'
  }`}>
    <div class="flex items-center gap-2">
      <span class="font-bold uppercase tracking-wider text-[11px] px-2 py-0.5 rounded bg-white border font-mono">
        {preIsDimPenalty ? '⚠️ Volumetric Penalty Active' : '✓ Scale Weight Dominant'}
      </span>
      <span id="sc-dim-banner-text">
        {preIsDimPenalty 
          ? `Dimensional weight (${preDimWeight.toFixed(2)} lbs) exceeds scale weight (${preActualLbs} lbs). Carrier will bill at ${Math.ceil(preBillableWeight)} lbs!` 
          : `Actual scale weight (${preActualLbs} lbs) exceeds DIM weight (${preDimWeight.toFixed(2)} lbs). No volumetric surcharge assessed.`}
      </span>
    </div>
    <span class="font-mono font-bold" id="sc-billable-badge">Billable: {preBillableWeight.toFixed(2)} lbs</span>
  </div>

  <!-- Visual Stacked Bar -->
  <div class="bg-slate-950 px-6 py-4 border-b border-slate-800">
    <div class="flex items-center justify-between text-xs text-slate-300 mb-2 font-mono">
      <span>Order Fulfillment Cost Allocation:</span>
      <span class="text-rose-400 font-bold" id="sc-bar-erosion-label">-{preMarginErosionPct.toFixed(1)}% Margin Erosion</span>
    </div>
    <div class="w-full h-4 bg-slate-800 rounded-full overflow-hidden flex shadow-inner">
      <div id="sc-bar-net" style={`width: ${preNetPct}%;`} class="bg-emerald-500 transition-all duration-150" title="Product Contribution"></div>
      <div id="sc-bar-postage" style={`width: ${prePostagePct}%;`} class="bg-indigo-500 transition-all duration-150" title="Carrier Label"></div>
      <div id="sc-bar-pack" style={`width: ${prePackagingPct}%;`} class="bg-amber-500 transition-all duration-150" title="Box & Labor"></div>
      <div id="sc-bar-deficit" style={`width: ${preDeficitPct}%;`} class="bg-rose-500 transition-all duration-150" title="Absorbed Subsidy"></div>
    </div>
    <div class="flex flex-wrap items-center gap-4 mt-2.5 text-[11px] text-slate-400">
      <div class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>Net Margin (<span id="sc-leg-net">{preNetPct.toFixed(1)}%</span>)</div>
      <div class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-indigo-500"></span>Carrier Label (<span id="sc-leg-postage">{prePostagePct.toFixed(1)}%</span>)</div>
      <div class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span>Box & Handling (<span id="sc-leg-pack">{prePackagingPct.toFixed(1)}%</span>)</div>
    </div>
  </div>

  <div class="p-6 sm:p-8 grid grid-cols-1 lg:grid-cols-12 gap-8">
    <!-- Controls (7 Cols) -->
    <div class="lg:col-span-7 space-y-5 text-sm">
      
      <!-- Package Weight & Carrier Preset -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="sc-weight" class="block font-semibold text-slate-800 mb-1">Actual Scale Weight (lbs)</label>
          <input
            type="number"
            id="sc-weight"
            step="0.1"
            min="0.1"
            value={preActualLbs}
            class="w-full px-3.5 py-2 rounded-lg border border-slate-300 focus:outline-hidden focus:ring-2 focus:ring-emerald-500 text-slate-900 font-semibold"
          />
        </div>

        <div>
          <label for="sc-carrier" class="block font-semibold text-slate-800 mb-1">Carrier Commercial Preset</label>
          <select id="sc-carrier" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-slate-900 bg-white focus:outline-hidden focus:ring-2 focus:ring-emerald-500">
            <option value="usps-ground" selected>USPS Ground Advantage (Commercial)</option>
            <option value="usps-priority">USPS Priority Mail (Commercial)</option>
            <option value="ups-ground">UPS Ground Commercial</option>
            <option value="fedex-ground">FedEx Home Delivery Commercial</option>
          </select>
        </div>
      </div>

      <!-- Dimensions (L x W x H) & Divisor -->
      <div>
        <label class="block font-semibold text-slate-800 mb-1">Exterior Package Dimensions (Inches)</label>
        <div class="grid grid-cols-3 gap-2">
          <div>
            <span class="text-[11px] text-slate-500 block mb-0.5">Length (in)</span>
            <input type="number" id="sc-length" step="0.5" min="1" value={preL} class="w-full px-3 py-2 rounded-lg border border-slate-300 focus:outline-hidden focus:ring-2 focus:ring-emerald-500 text-slate-900 font-semibold text-center" />
          </div>
          <div>
            <span class="text-[11px] text-slate-500 block mb-0.5">Width (in)</span>
            <input type="number" id="sc-width" step="0.5" min="1" value={preW} class="w-full px-3 py-2 rounded-lg border border-slate-300 focus:outline-hidden focus:ring-2 focus:ring-emerald-500 text-slate-900 font-semibold text-center" />
          </div>
          <div>
            <span class="text-[11px] text-slate-500 block mb-0.5">Height (in)</span>
            <input type="number" id="sc-height" step="0.5" min="1" value={preH} class="w-full px-3 py-2 rounded-lg border border-slate-300 focus:outline-hidden focus:ring-2 focus:ring-emerald-500 text-slate-900 font-semibold text-center" />
          </div>
        </div>
      </div>

      <!-- Divisor & Material Costs -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div>
          <label for="sc-divisor" class="block font-semibold text-slate-800 mb-1">DIM Divisor</label>
          <select id="sc-divisor" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-slate-900 bg-white focus:outline-hidden focus:ring-2 focus:ring-emerald-500">
            <option value="166" selected>166 (USPS Commercial)</option>
            <option value="139">139 (UPS / FedEx Commercial)</option>
          </select>
        </div>

        <div>
          <label for="sc-box-cost" class="block font-semibold text-slate-800 mb-1">Packaging Box Cost ($)</label>
          <div class="relative">
            <span class="absolute left-3 top-2 text-slate-400 font-bold">$</span>
            <input type="number" id="sc-box-cost" step="0.05" min="0" value={preBoxCost.toFixed(2)} class="w-full pl-8 pr-3 py-2 rounded-lg border border-slate-300 focus:outline-hidden focus:ring-2 focus:ring-emerald-500 text-slate-900 font-semibold" />
          </div>
        </div>

        <div>
          <label for="sc-handling" class="block font-semibold text-slate-800 mb-1">Handling Labor ($)</label>
          <div class="relative">
            <span class="absolute left-3 top-2 text-slate-400 font-bold">$</span>
            <input type="number" id="sc-handling" step="0.1" min="0" value={preHandling.toFixed(2)} class="w-full pl-8 pr-3 py-2 rounded-lg border border-slate-300 focus:outline-hidden focus:ring-2 focus:ring-emerald-500 text-slate-900 font-semibold" />
          </div>
        </div>
      </div>

      <!-- Customer Charged & Product Selling Price -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div>
          <label for="sc-ship-charged" class="block font-semibold text-slate-800 mb-1">Customer Paid Shipping ($)</label>
          <div class="relative">
            <span class="absolute left-3 top-2 text-slate-400 font-bold">$</span>
            <input type="number" id="sc-ship-charged" step="0.5" min="0" value={preShipCharged.toFixed(2)} class="w-full pl-8 pr-3 py-2 rounded-lg border border-slate-300 focus:outline-hidden focus:ring-2 focus:ring-emerald-500 text-slate-900 font-semibold" />
          </div>
          <span class="text-[11px] text-slate-500">$0 = Free Shipping</span>
        </div>

        <div>
          <label for="sc-price" class="block font-semibold text-slate-800 mb-1">Product Price ($)</label>
          <div class="relative">
            <span class="absolute left-3 top-2 text-slate-400 font-bold">$</span>
            <input type="number" id="sc-price" step="1" min="1" value={prePrice.toFixed(2)} class="w-full pl-8 pr-3 py-2 rounded-lg border border-slate-300 focus:outline-hidden focus:ring-2 focus:ring-emerald-500 text-slate-900 font-semibold" />
          </div>
        </div>

        <div>
          <label for="sc-target-margin" class="block font-semibold text-slate-800 mb-1">Target Net Margin (%)</label>
          <div class="relative">
            <input type="number" id="sc-target-margin" step="1" min="5" max="95" value={preTargetMargin.toFixed(0)} class="w-full pr-8 pl-3.5 py-2 rounded-lg border border-slate-300 focus:outline-hidden focus:ring-2 focus:ring-emerald-500 text-slate-900 font-semibold" />
            <span class="absolute right-3 top-2 text-slate-400 font-bold">%</span>
          </div>
        </div>
      </div>

    </div>

    <!-- Output Dashboard (5 Cols) -->
    <div class="lg:col-span-5 bg-slate-50 rounded-xl p-6 border border-slate-200 flex flex-col justify-between">
      <div>
        <h3 class="text-xs font-mono uppercase tracking-wider text-slate-500 font-bold mb-3">
          Fulfillment Cost & Margin Impact
        </h3>

        <!-- Hero Card -->
        <div class="bg-white rounded-xl p-5 border border-slate-200 shadow-xs mb-4">
          <div class="text-xs font-semibold text-slate-500">Total Landed Fulfillment Cost</div>
          <div id="sc-out-total-cost" class="text-3xl sm:text-4xl font-extrabold text-slate-900 font-mono mt-1">
            ${preTotalFulfillment.toFixed(2)}
          </div>
          <div class="flex items-center justify-between mt-2 pt-2 border-t border-slate-100 text-xs">
            <span class="text-slate-500">Margin Erosion:</span>
            <span id="sc-out-erosion" class="font-bold text-rose-600 font-mono text-sm">-{preMarginErosionPct.toFixed(2)}%</span>
          </div>
        </div>

        <!-- Metrics Table -->
        <div class="space-y-2 text-xs font-mono">
          <div class="flex justify-between py-1 border-b border-slate-200">
            <span class="text-slate-600">Carrier Label Postage:</span>
            <span id="sc-out-label" class="font-bold text-slate-900">${prePostageCost.toFixed(2)}</span>
          </div>
          <div class="flex justify-between py-1 border-b border-slate-200">
            <span class="text-slate-600">Packaging + Labor:</span>
            <span id="sc-out-pack-labor" class="text-slate-700">${(preBoxCost + preHandling).toFixed(2)}</span>
          </div>
          <div class="flex justify-between py-1 border-b border-slate-200">
            <span class="text-slate-600">Absorbed Fulfillment Deficit:</span>
            <span id="sc-out-deficit" class="text-rose-600 font-semibold">${preFulfillmentDeficit.toFixed(2)}</span>
          </div>
          <div class="flex justify-between py-1 border-b border-slate-200">
            <span class="text-slate-600">Recommended Shipping Charge:</span>
            <span id="sc-out-recommended" class="font-bold text-emerald-700">${preRecommendedShipping.toFixed(2)}</span>
          </div>
          <div class="flex justify-between py-1">
            <span class="text-slate-600">Free Shipping Minimum AOV:</span>
            <span id="sc-out-aov" class="font-bold text-indigo-700">${preFreeShipAov.toFixed(2)}</span>
          </div>
        </div>
      </div>

      <!-- Actionable Threshold Callout -->
      <div class="mt-5 pt-4 border-t border-slate-200 bg-white p-4 rounded-lg border border-slate-200 text-xs">
        <div class="font-bold text-slate-900 mb-1">Free Shipping Strategy</div>
        <p class="text-slate-600 text-[11px] leading-relaxed" id="sc-out-strategy-text">
          To absorb ${preTotalFulfillment.toFixed(2)} in delivery while keeping your {preTargetMargin}% profit margin, set your free shipping threshold at <strong class="text-slate-900 font-bold">${preFreeShipAov.toFixed(2)} AOV</strong>.
        </p>
      </div>
    </div>
  </div>

  <!-- Disclaimer Footer -->
  <div class="bg-slate-100 border-t border-slate-200 px-6 py-4 text-xs text-slate-600 flex items-start gap-3">
    <svg class="w-5 h-5 text-slate-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>
    <p class="leading-relaxed">
      <strong>Commercial Postal Disclaimer:</strong> Postage figures are based on 2026 USPS Notice 123 commercial base rates and standard commercial courier DIM weight divisor rules. Actual rates vary by delivery zone (Zone 1 to Zone 9) and fuel surcharges.
    </p>
  </div>
</div>

<script define:vars={{ carrierRates, defaultInputs: d }}>
  const elWeight = document.getElementById('sc-weight');
  const elCarrier = document.getElementById('sc-carrier');
  const elL = document.getElementById('sc-length');
  const elW = document.getElementById('sc-width');
  const elH = document.getElementById('sc-height');
  const elDivisor = document.getElementById('sc-divisor');
  const elBox = document.getElementById('sc-box-cost');
  const elHandling = document.getElementById('sc-handling');
  const elShipCharged = document.getElementById('sc-ship-charged');
  const elPrice = document.getElementById('sc-price');
  const elMargin = document.getElementById('sc-target-margin');

  // Outputs
  const outTotalCost = document.getElementById('sc-out-total-cost');
  const outErosion = document.getElementById('sc-out-erosion');
  const outLabel = document.getElementById('sc-out-label');
  const outPackLabor = document.getElementById('sc-out-pack-labor');
  const outDeficit = document.getElementById('sc-out-deficit');
  const outRecommended = document.getElementById('sc-out-recommended');
  const outAov = document.getElementById('sc-out-aov');
  const outStrategyText = document.getElementById('sc-out-strategy-text');

  // Banner
  const dimBanner = document.getElementById('sc-dim-banner');
  const dimBannerText = document.getElementById('sc-dim-banner-text');
  const billableBadge = document.getElementById('sc-billable-badge');

  // Bars
  const barNet = document.getElementById('sc-bar-net');
  const barPostage = document.getElementById('sc-bar-postage');
  const barPack = document.getElementById('sc-bar-pack');
  const barDeficit = document.getElementById('sc-bar-deficit');
  const barErosionLabel = document.getElementById('sc-bar-erosion-label');
  const legNet = document.getElementById('sc-leg-net');
  const legPostage = document.getElementById('sc-leg-postage');
  const legPack = document.getElementById('sc-leg-pack');

  const shareBtn = document.getElementById('sc-share-btn');
  const shareText = document.getElementById('sc-share-text');
  const exportBtn = document.getElementById('sc-export-btn');
  const exportText = document.getElementById('sc-export-text');
  const resetBtn = document.getElementById('sc-reset-btn');

  let debounceTimer = null;

  function calculate() {
    if (!elWeight || !elCarrier || !elL || !elW || !elH || !elDivisor || !elBox || !elHandling || !elShipCharged || !elPrice || !elMargin) return;

    const actualWeight = Math.max(0.1, parseFloat(elWeight.value) || 0.1);
    const carrier = elCarrier.value || 'usps-ground';
    const l = Math.max(1, parseFloat(elL.value) || 1);
    const w = Math.max(1, parseFloat(elW.value) || 1);
    const h = Math.max(1, parseFloat(elH.value) || 1);
    const divisor = parseFloat(elDivisor.value) || 166;
    const boxCost = Math.max(0, parseFloat(elBox.value) || 0);
    const handling = Math.max(0, parseFloat(elHandling.value) || 0);
    const shipCharged = Math.max(0, parseFloat(elShipCharged.value) || 0);
    const price = Math.max(1, parseFloat(elPrice.value) || 1);
    const targetMargin = Math.max(1, Math.min(99, parseFloat(elMargin.value) || 40));

    const cubic = l * w * h;
    const dimWeight = cubic / divisor;
    const billableWeight = Math.max(actualWeight, dimWeight);
    const isDimPenalty = dimWeight > actualWeight;

    // Postage calculation
    const rateConfig = carrierRates[carrier] || carrierRates['usps-ground'];
    const postageCost = rateConfig.base + (Math.max(0, billableWeight - 1) * rateConfig.perLb);
    const totalFulfillment = postageCost + boxCost + handling;
    const fulfillmentDeficit = Math.max(0, totalFulfillment - shipCharged);
    const erosionPct = (fulfillmentDeficit / price) * 100;
    const freeShipAov = totalFulfillment / (targetMargin / 100);

    // Update Banner
    if (dimBanner && dimBannerText && billableBadge) {
      if (isDimPenalty) {
        dimBanner.className = 'px-6 py-3.5 border-b flex items-center justify-between gap-3 text-xs bg-amber-500/10 border-amber-300 text-amber-950';
        dimBannerText.textContent = `Dimensional weight (${dimWeight.toFixed(2)} lbs) exceeds scale weight (${actualWeight.toFixed(2)} lbs). Carrier will bill at ${Math.ceil(billableWeight)} lbs!`;
      } else {
        dimBanner.className = 'px-6 py-3.5 border-b flex items-center justify-between gap-3 text-xs bg-emerald-500/10 border-emerald-300 text-emerald-950';
        dimBannerText.textContent = `Actual scale weight (${actualWeight.toFixed(2)} lbs) exceeds DIM weight (${dimWeight.toFixed(2)} lbs). No volumetric surcharge assessed.`;
      }
      billableBadge.textContent = `Billable: ${billableWeight.toFixed(2)} lbs`;
    }

    // Update Outputs
    if (outTotalCost) outTotalCost.textContent = `$${totalFulfillment.toFixed(2)}`;
    if (outErosion) outErosion.textContent = `-${erosionPct.toFixed(2)}%`;
    if (outLabel) outLabel.textContent = `$${postageCost.toFixed(2)}`;
    if (outPackLabor) outPackLabor.textContent = `$${(boxCost + handling).toFixed(2)}`;
    if (outDeficit) outDeficit.textContent = `$${fulfillmentDeficit.toFixed(2)}`;
    if (outRecommended) outRecommended.textContent = `$${totalFulfillment.toFixed(2)}`;
    if (outAov) outAov.textContent = `$${freeShipAov.toFixed(2)}`;
    if (outStrategyText) {
      outStrategyText.innerHTML = `To absorb $${totalFulfillment.toFixed(2)} in delivery while keeping your ${targetMargin}% profit margin, set your free shipping threshold at <strong class="text-slate-900 font-bold">$${freeShipAov.toFixed(2)} AOV</strong>.`;
    }

    // Update Stacked Bar
    const gross = price + shipCharged;
    const netAfterShip = Math.max(0, price - totalFulfillment);
    const netPct = gross > 0 ? (netAfterShip / gross) * 100 : 50;
    const postPct = gross > 0 ? (postageCost / gross) * 100 : 25;
    const packPct = gross > 0 ? ((boxCost + handling) / gross) * 100 : 15;
    const defPct = Math.max(0, 100 - netPct - postPct - packPct);

    if (barNet) barNet.style.width = `${netPct}%`;
    if (barPostage) barPostage.style.width = `${postPct}%`;
    if (barPack) barPack.style.width = `${packPct}%`;
    if (barDeficit) barDeficit.style.width = `${defPct}%`;
    if (barErosionLabel) barErosionLabel.textContent = `-${erosionPct.toFixed(1)}% Margin Erosion`;

    if (legNet) legNet.textContent = `${netPct.toFixed(1)}%`;
    if (legPostage) legPostage.textContent = `${postPct.toFixed(1)}%`;
    if (legPack) legPack.textContent = `${packPct.toFixed(1)}%`;

    // URL Sync
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(() => {
      const p = new URLSearchParams();
      p.set('weight', actualWeight.toString());
      p.set('l', l.toString());
      p.set('w', w.toString());
      p.set('h', h.toString());
      p.set('div', divisor.toString());
      p.set('carrier', carrier);
      p.set('box', boxCost.toString());
      p.set('labor', handling.toString());
      p.set('charged', shipCharged.toString());
      p.set('price', price.toString());
      p.set('margin', targetMargin.toString());
      window.history.replaceState({}, '', `${window.location.pathname}?${p.toString()}`);
    }, 200);
  }

  [elWeight, elCarrier, elL, elW, elH, elDivisor, elBox, elHandling, elShipCharged, elPrice, elMargin].forEach(el => {
    el?.addEventListener('input', calculate);
    el?.addEventListener('change', calculate);
  });

  // Share
  shareBtn?.addEventListener('click', () => {
    navigator.clipboard.writeText(window.location.href).then(() => {
      if (shareText) shareText.textContent = 'Copied!';
      setTimeout(() => { if (shareText) shareText.textContent = 'Share Link'; }, 2000);
    });
  });

  // Export
  exportBtn?.addEventListener('click', () => {
    const text = [
      `--- SHIPPING & DIM WEIGHT AUDIT (CreatorCalcLab) ---`,
      `Actual Weight: ${elWeight?.value} lbs`,
      `Dimensions: ${elL?.value}x${elW?.value}x${elH?.value} in`,
      `Billable Weight: ${billableBadge?.textContent || ''}`,
      `Carrier Label Rate: ${outLabel?.textContent || ''}`,
      `Total Fulfillment Cost: ${outTotalCost?.textContent || ''}`,
      `Margin Erosion: ${outErosion?.textContent || ''}`,
      `Recommended Free Shipping Minimum: ${outAov?.textContent || ''}`,
      `Audit Link: ${window.location.href}`,
      `----------------------------------------------------`
    ].join('\n');

    navigator.clipboard.writeText(text).then(() => {
      if (exportText) exportText.textContent = 'Copied Receipt!';
      setTimeout(() => { if (exportText) exportText.textContent = 'Copy Receipt'; }, 2000);
    });
  });

  // Reset
  resetBtn?.addEventListener('click', () => {
    if (elWeight) elWeight.value = (defaultInputs.actualWeightLbs || 2.5).toString();
    if (elL) elL.value = (defaultInputs.lengthInches || 12).toString();
    if (elW) elW.value = (defaultInputs.widthInches || 10).toString();
    if (elH) elH.value = (defaultInputs.heightInches || 6).toString();
    if (elDivisor) elDivisor.value = (defaultInputs.dimDivisor || 166).toString();
    if (elCarrier) elCarrier.value = defaultInputs.carrierPreset || 'usps-ground';
    if (elBox) elBox.value = (defaultInputs.packagingCost || 1.25).toFixed(2);
    if (elHandling) elHandling.value = (defaultInputs.handlingCost || 1.50).toFixed(2);
    if (elShipCharged) elShipCharged.value = (defaultInputs.shippingCharged || 0.0).toFixed(2);
    if (elPrice) elPrice.value = (defaultInputs.productPrice || 75.0).toFixed(2);
    if (elMargin) elMargin.value = (defaultInputs.targetMargin || 40.0).toString();
    window.history.replaceState({}, '', window.location.pathname);
    calculate();
  });

  // Hydrate
  function hydrate() {
    const p = new URLSearchParams(window.location.search);
    if (!p.has('weight') && !p.has('l')) return;
    if (p.has('weight') && elWeight) elWeight.value = p.get('weight');
    if (p.has('l') && elL) elL.value = p.get('l');
    if (p.has('w') && elW) elW.value = p.get('w');
    if (p.has('h') && elH) elH.value = p.get('h');
    if (p.has('div') && elDivisor) elDivisor.value = p.get('div');
    if (p.has('carrier') && elCarrier) elCarrier.value = p.get('carrier');
    if (p.has('box') && elBox) elBox.value = p.get('box');
    if (p.has('labor') && elHandling) elHandling.value = p.get('labor');
    if (p.has('charged') && elShipCharged) elShipCharged.value = p.get('charged');
    if (p.has('price') && elPrice) elPrice.value = p.get('price');
    if (p.has('margin') && elMargin) elMargin.value = p.get('margin');
    calculate();
  }

  hydrate();
</script>
