---
import { SITE_CONFIG } from '../config/site';
import { getPath } from '../utils/paths';

const currentYear = SITE_CONFIG.currentYear;
---

<footer class="bg-slate-900 text-slate-300 border-t border-slate-800">
  <!-- Top Trust & Methodology Banner -->
  <div class="border-b border-slate-800 bg-slate-950/60 py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-sm">
        <div class="flex items-start space-x-3">
          <div class="w-8 h-8 rounded-lg bg-emerald-500/10 text-emerald-400 flex items-center justify-center shrink-0 border border-emerald-500/20">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <div>
            <h4 class="font-semibold text-white">2026 Verified Fee Schedules</h4>
            <p class="text-slate-400 text-xs mt-1">
              Platform take-rates, credit card interchange tiers, and subscription prices are cross-referenced monthly against official SEC filings and developer terms.
            </p>
          </div>
        </div>

        <div class="flex items-start space-x-3">
          <div class="w-8 h-8 rounded-lg bg-emerald-500/10 text-emerald-400 flex items-center justify-center shrink-0 border border-emerald-500/20">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
          </div>
          <div>
            <h4 class="font-semibold text-white">Zero Server Data Storage</h4>
            <p class="text-slate-400 text-xs mt-1">
              All financial inputs, revenue figures, and cost variables execute strictly within your local browser environment. We never store, log, or sell your proprietary numbers.
            </p>
          </div>
        </div>

        <div class="flex items-start space-x-3">
          <div class="w-8 h-8 rounded-lg bg-emerald-500/10 text-emerald-400 flex items-center justify-center shrink-0 border border-emerald-500/20">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 8v8m-4-5v5m-4-2v2m-2 4h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
          <div>
            <h4 class="font-semibold text-white">Independent Financial Modeling</h4>
            <p class="text-slate-400 text-xs mt-1">
              Zero affiliate skew. Our algorithms use deterministic, double-entry mathematical principles so you get unvarnished unit economics every time.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Links Navigation -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <!-- Col 1: Brand & Overview -->
      <div class="space-y-4">
        <a href={getPath('/')} class="flex items-center space-x-3">
          <div class="w-8 h-8 rounded-lg bg-emerald-600 flex items-center justify-center text-white font-bold text-lg">
            C
          </div>
          <span class="text-lg font-bold text-white tracking-tight">{SITE_CONFIG.siteName}</span>
        </a>
        <p class="text-slate-400 text-xs leading-relaxed">
          The open computational laboratory for direct-to-consumer retailers, YouTube creators, independent software developers, and professional service consultants.
        </p>
        <div class="pt-2">
          <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-emerald-950 text-emerald-400 border border-emerald-800">
            Current Baseline: 2026 Audit
          </span>
        </div>
      </div>

      <!-- Col 2: Category Clusters -->
      <div>
        <h4 class="text-white text-sm font-semibold tracking-wider uppercase mb-3">Calculators by Sector</h4>
        <ul class="space-y-2 text-xs">
          <li>
            <a href={getPath('/all-calculators/')} class="text-emerald-400 font-semibold hover:text-emerald-300 transition-colors flex items-center gap-1.5 pb-1 mb-1 border-b border-slate-800">
              <span>View All 62 Calculators &rarr;</span>
            </a>
          </li>
          <li>
            <a href={getPath('/category/ecommerce/')} class="text-slate-400 hover:text-emerald-400 transition-colors">
              E-Commerce & DTC Margins
            </a>
          </li>
          <li>
            <a href={getPath('/category/creator-economy/')} class="text-slate-400 hover:text-emerald-400 transition-colors">
              Creator Economy & Ad Splits
            </a>
          </li>
          <li>
            <a href={getPath('/category/digital-marketplaces/')} class="text-slate-400 hover:text-emerald-400 transition-colors">
              Digital Marketplaces & Storefronts
            </a>
          </li>
          <li>
            <a href={getPath('/category/b2b-pricing/')} class="text-slate-400 hover:text-emerald-400 transition-colors">
              B2B Hourly & Retainer Pricing
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Research & Citations -->
      <div>
        <h4 class="text-white text-sm font-semibold tracking-wider uppercase mb-3">Official Fee Documentation</h4>
        <ul class="space-y-2 text-xs">
          <li>
            <a href={SITE_CONFIG.officialCitations.shopifyPricing.url} target="_blank" rel="noopener noreferrer" class="text-slate-400 hover:text-emerald-400 transition-colors flex items-center justify-between">
              <span>Shopify Merchant Pricing</span>
              <svg class="w-3 h-3 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
            </a>
          </li>
          <li>
            <a href={SITE_CONFIG.officialCitations.etsyFeePolicy.url} target="_blank" rel="noopener noreferrer" class="text-slate-400 hover:text-emerald-400 transition-colors flex items-center justify-between">
              <span>Etsy Seller Fee Schedule</span>
              <svg class="w-3 h-3 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
            </a>
          </li>
          <li>
            <a href={SITE_CONFIG.officialCitations.youtubePartnerProgram.url} target="_blank" rel="noopener noreferrer" class="text-slate-400 hover:text-emerald-400 transition-colors flex items-center justify-between">
              <span>YouTube Partner Program Terms</span>
              <svg class="w-3 h-3 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
            </a>
          </li>
          <li>
            <a href={SITE_CONFIG.officialCitations.stripePricing.url} target="_blank" rel="noopener noreferrer" class="text-slate-400 hover:text-emerald-400 transition-colors flex items-center justify-between">
              <span>Stripe Processing Terms</span>
              <svg class="w-3 h-3 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
            </a>
          </li>
          <li>
            <a href={SITE_CONFIG.officialCitations.irsSelfEmployment.url} target="_blank" rel="noopener noreferrer" class="text-slate-400 hover:text-emerald-400 transition-colors flex items-center justify-between">
              <span>IRS Schedule SE Guidelines</span>
              <svg class="w-3 h-3 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 4: Institutional Governance & Legal -->
      <div>
        <h4 class="text-white text-sm font-semibold tracking-wider uppercase mb-3">Compliance & Governance</h4>
        <ul class="space-y-2 text-xs">
          <li>
            <a href={getPath('/about/')} class="text-slate-400 hover:text-emerald-400 transition-colors">
              Editorial Standards & Financial Methodology
            </a>
          </li>
          <li>
            <a href={getPath('/contact/')} class="text-slate-400 hover:text-emerald-400 transition-colors">
              Contact Compliance & Fee Audit Desk
            </a>
          </li>
          <li>
            <a href={getPath('/privacy-policy/')} class="text-slate-400 hover:text-emerald-400 transition-colors">
              Privacy Policy (AdSense & GDPR)
            </a>
          </li>
          <li>
            <a href={getPath('/terms/')} class="text-slate-400 hover:text-emerald-400 transition-colors">
              Terms of Service & Disclaimer
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Mandatory YMYL & Legal Financial Disclaimer -->
    <div class="mt-12 pt-8 border-t border-slate-800 text-xs text-slate-400 leading-relaxed space-y-4">
      <div class="bg-slate-950 p-4 rounded-lg border border-slate-800">
        <p class="font-semibold text-slate-300 uppercase tracking-wide text-[11px] mb-1">
          Strict Financial, Tax & Legal Notice (YMYL Compliance)
        </p>
        <p>
          CreatorCalcLab provides computational modeling tools, interactive simulations, and informational guides for analytical and educational use only. Mathematical outputs do not constitute certified public accounting (CPA), fiduciary tax preparation, investment underwriting, or formal legal advice. While fee rates, interchange charges, and baseline platform metrics are routinely audited against official 2026 platform schedules, actual platform billing, gateway dispute assessments, and local sales tax obligations vary based on individual seller account standing, sales volume, cross-border jurisdictions, and changing corporate terms. Users are advised to review official platform agreements and consult a certified CPA or tax attorney regarding specific commercial transactions.
        </p>
      </div>

      <div class="flex flex-col sm:flex-row items-center justify-between text-[11px] text-slate-500 pt-4">
        <p>
          &copy; {currentYear} {SITE_CONFIG.siteName}. All rights reserved. 100% Static Pre-Rendered Architecture.
        </p>
        <p class="mt-2 sm:mt-0">
          Independent publication. Not affiliated with or endorsed by Shopify Inc., Etsy Inc., Google LLC, or Stripe Inc.
        </p>
      </div>
    </div>
  </div>
</footer>
