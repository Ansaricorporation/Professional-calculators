---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE_CONFIG } from '../config/site';
import { getPath } from '../utils/paths';

const breadcrumbItems = [
  { name: 'Contact & Support', url: getPath('/contact/') }
];
---

<BaseLayout
  title="Contact Us & Fee Audit Desk"
  metaTitle="Contact CreatorCalcLab | Fee Schedule Update Requests & Editorial Support"
  description="Contact CreatorCalcLab's financial audit team to request platform fee schedule updates, report formula discrepancies, or submit business inquiries."
  canonicalPath="/contact/"
>
  <div class="bg-white border-b border-slate-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <Breadcrumbs items={breadcrumbItems} />
      <div class="mt-4">
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800">
          Direct Editorial Line
        </span>
        <h1 class="mt-3 text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
          Contact Our Financial & Compliance Desk
        </h1>
        <p class="mt-2 text-base text-slate-600 leading-relaxed">
          Have an updated platform rate card, a suggestion for a new calculator, or a calculation inquiry? Our research team reviews all community submissions.
        </p>
      </div>
    </div>
  </div>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      
      <!-- Contact Info Sidebar -->
      <div class="space-y-6">
        <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-xs">
          <h3 class="text-sm font-bold uppercase tracking-wider text-slate-900 mb-4">Direct Communication</h3>
          
          <div class="space-y-4 text-xs">
            <div>
              <span class="block text-slate-500 font-medium">Compliance & Fee Audits:</span>
              <a href={`mailto:${SITE_CONFIG.contactEmail}`} class="font-mono text-emerald-700 font-bold hover:underline">
                {SITE_CONFIG.contactEmail}
              </a>
            </div>
            
            <div>
              <span class="block text-slate-500 font-medium">Editorial Review Desk:</span>
              <span class="font-mono text-slate-700">editorial@creatorcalclab.com</span>
            </div>

            <div>
              <span class="block text-slate-500 font-medium">Estimated Response Time:</span>
              <span class="text-slate-800 font-medium">Within 24 to 48 business hours</span>
            </div>
          </div>
        </div>

        <div class="bg-emerald-50 p-6 rounded-xl border border-emerald-200 text-xs text-emerald-900">
          <h4 class="font-bold text-sm text-emerald-950 mb-2 flex items-center gap-1.5">
            <svg class="w-4 h-4 text-emerald-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            Fee Schedule Update Protocol
          </h4>
          <p class="leading-relaxed">
            If a platform (Shopify, Etsy, Stripe, Gumroad, etc.) has updated its fee card or terms of service, please provide a link to the official press release or merchant policy documentation. Our research team audits and deploys rate updates within 48 hours of verification.
          </p>
        </div>
      </div>

      <!-- Interactive Form UI -->
      <div class="md:col-span-2 bg-white p-6 sm:p-8 rounded-xl border border-slate-200 shadow-xs">
        <h2 class="text-xl font-bold text-slate-900 mb-6">Send an Inquiry to Our Analysts</h2>
        
        <form id="contact-form" class="space-y-5 text-sm" onsubmit="event.preventDefault(); document.getElementById('form-success-notice')?.classList.remove('hidden'); this.reset();">
          <div>
            <label for="contact-category" class="block font-semibold text-slate-800 mb-1">
              Inquiry Department <span class="text-rose-500">*</span>
            </label>
            <select
              id="contact-category"
              name="department"
              required
              class="w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-slate-900 bg-white focus:outline-hidden focus:ring-2 focus:ring-emerald-500"
            >
              <option value="fee-update">Fee Schedule Update Request (Platform Rate Change)</option>
              <option value="formula-bug">Formula Discrepancy / Math Error Report</option>
              <option value="new-calculator">Request a New Calculator or Platform Engine</option>
              <option value="business">Advertising / Partnership / General Press</option>
            </select>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="contact-name" class="block font-semibold text-slate-800 mb-1">
                Your Name <span class="text-rose-500">*</span>
              </label>
              <input
                type="text"
                id="contact-name"
                name="name"
                required
                placeholder="Jane Doe"
                class="w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-slate-900 placeholder-slate-400 focus:outline-hidden focus:ring-2 focus:ring-emerald-500"
              />
            </div>
            <div>
              <label for="contact-email" class="block font-semibold text-slate-800 mb-1">
                Business Email Address <span class="text-rose-500">*</span>
              </label>
              <input
                type="email"
                id="contact-email"
                name="email"
                required
                placeholder="jane@example.com"
                class="w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-slate-900 placeholder-slate-400 focus:outline-hidden focus:ring-2 focus:ring-emerald-500"
              />
            </div>
          </div>

          <div>
            <label for="contact-subject" class="block font-semibold text-slate-800 mb-1">
              Subject Line <span class="text-rose-500">*</span>
            </label>
            <input
              type="text"
              id="contact-subject"
              name="subject"
              required
              placeholder="e.g., Shopify 2026 Advanced Plan Credit Card Interchange Rate Verification"
              class="w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-slate-900 placeholder-slate-400 focus:outline-hidden focus:ring-2 focus:ring-emerald-500"
            />
          </div>

          <div>
            <label for="contact-message" class="block font-semibold text-slate-800 mb-1">
              Detailed Message & Documentation Links <span class="text-rose-500">*</span>
            </label>
            <textarea
              id="contact-message"
              name="message"
              rows="5"
              required
              placeholder="Please provide specific formula feedback, calculator URL, or platform documentation link..."
              class="w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-slate-900 placeholder-slate-400 focus:outline-hidden focus:ring-2 focus:ring-emerald-500 text-sm"
            ></textarea>
          </div>

          <div class="flex items-start space-x-2 text-xs text-slate-600">
            <input
              type="checkbox"
              id="privacy-consent"
              required
              class="mt-0.5 rounded border-slate-300 text-emerald-600 focus:ring-emerald-500"
            />
            <label for="privacy-consent">
              I agree that CreatorCalcLab may process this inquiry in accordance with its <a href={getPath('/privacy-policy/')} class="text-emerald-700 underline">Privacy Policy</a>. No marketing emails will be sent.
            </label>
          </div>

          <div>
            <button
              type="submit"
              class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-3 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-sm shadow-xs transition-colors focus:outline-hidden focus:ring-2 focus:ring-emerald-500 focus:ring-offset-2"
            >
              Submit Inquiry to Research Team
            </button>
          </div>

          <div id="form-success-notice" class="hidden p-4 rounded-lg bg-emerald-100 border border-emerald-300 text-emerald-900 text-xs">
            <strong>Inquiry Received:</strong> Thank you for your feedback. Our financial review desk will inspect your submission against official platform documentation.
          </div>
        </form>
      </div>

    </div>
  </div>
</BaseLayout>
