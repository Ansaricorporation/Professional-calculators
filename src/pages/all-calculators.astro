---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllCalculators } from '../data/calculators';
import { SITE_CONFIG } from '../config/site';
import { getPath } from '../utils/paths';

const allCalculators = getAllCalculators();

const categories = [
  {
    id: 'ecommerce',
    name: 'E-Commerce & Direct-to-Consumer',
    description: 'Shopify margins, shipping dimensional weights, AOV lift, and TikTok Shop referral fees.',
    badgeColor: 'bg-emerald-100 text-emerald-800 border-emerald-200',
    icon: 'cart',
    calculators: allCalculators.filter(c => c.category === 'ecommerce')
  },
  {
    id: 'creator-economy',
    name: 'Creator Economy & Ad Revenue',
    description: 'YouTube RPM benchmarks by niche, Shorts vs. Long-form splits, TikTok Creator Rewards, and Twitch sub earnings.',
    badgeColor: 'bg-rose-100 text-rose-800 border-rose-200',
    icon: 'video',
    calculators: allCalculators.filter(c => c.category === 'creator-economy')
  },
  {
    id: 'digital-marketplaces',
    name: 'Digital Marketplaces & Software',
    description: 'Gumroad 10% vs Discover 30%, Lemon Squeezy MoR, Patreon tiers, Substack 10% cut, and Payhip plan break-even.',
    badgeColor: 'bg-indigo-100 text-indigo-800 border-indigo-200',
    icon: 'shop',
    calculators: allCalculators.filter(c => c.category === 'digital-marketplaces')
  },
  {
    id: 'b2b-pricing',
    name: 'B2B Pricing, Invoicing & Tax',
    description: 'Stripe & PayPal interchange, Upwork vs. Fiverr fees, freelance hourly rates, Schedule SE self-employment tax, day rates, retainers, and late fees.',
    badgeColor: 'bg-amber-100 text-amber-800 border-amber-200',
    icon: 'briefcase',
    calculators: allCalculators.filter(c => c.category === 'b2b-pricing')
  }
];

const totalCalculators = allCalculators.length;
---

<BaseLayout
  title="All Financial Calculators"
  metaTitle={`All Financial Calculators | ${totalCalculators} Interactive Tools (2026)`}
  description={`Comprehensive directory of all ${totalCalculators} free financial calculators for online sellers, digital creators, freelancers, and agencies. Audited for official 2026 platform rate schedules.`}
  canonicalPath="/all-calculators/"
>
  <!-- Hero Header -->
  <div class="bg-gradient-to-b from-slate-900 via-slate-900 to-slate-800 text-white py-12 md:py-16 border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb -->
      <nav class="flex items-center space-x-2 text-xs font-mono text-slate-400 mb-6">
        <a href={getPath('/')} class="hover:text-emerald-400 transition-colors">Home</a>
        <span>/</span>
        <span class="text-emerald-400 font-semibold">All Calculators</span>
      </nav>

      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 mb-4">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          Complete 2026 Directory: {totalCalculators} Production Calculators
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white mb-4">
          All Interactive Financial Calculators
        </h1>

        <p class="text-base sm:text-lg text-slate-300 leading-relaxed mb-8">
          Every tool is 100% free, runs client-side with zero data tracking, and incorporates verified 2026 platform fee schedules, tax withholding baselines, and mathematical unit economic formulas.
        </p>

        <!-- Category Anchor Jump Pills -->
        <div class="flex flex-wrap items-center gap-2 pt-2">
          <span class="text-xs font-mono text-slate-400 uppercase tracking-wider mr-1">Quick Jump:</span>
          {categories.map(cat => (
            <a
              href={`#${cat.id}`}
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium bg-slate-800/90 text-slate-200 border border-slate-700 hover:bg-slate-700 hover:text-white transition-all shadow-xs"
            >
              <span>{cat.name.split('&')[0].trim()}</span>
              <span class="px-1.5 py-0.2 rounded-full bg-slate-900 text-emerald-400 font-mono text-[10px]">
                {cat.calculators.length}
              </span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- Main Directory Body -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-16">
    {categories.map(cat => (
      <section id={cat.id} class="scroll-mt-24">
        <!-- Category Section Header -->
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 pb-4 border-b border-slate-200 mb-8">
          <div>
            <div class="flex items-center gap-2.5 mb-1.5">
              <span class={`inline-flex items-center px-2.5 py-0.5 rounded-md text-xs font-semibold border ${cat.badgeColor}`}>
                {cat.calculators.length} Calculators
              </span>
              <a href={getPath(`/category/${cat.id}/`)} class="text-xs font-mono text-emerald-600 hover:text-emerald-700 font-semibold underline underline-offset-2">
                View Category Hub &rarr;
              </a>
            </div>
            <h2 class="text-2xl font-bold tracking-tight text-slate-900">
              {cat.name}
            </h2>
            <p class="text-sm text-slate-600 mt-1 max-w-2xl">
              {cat.description}
            </p>
          </div>
        </div>

        <!-- Calculator Cards Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {cat.calculators.map(calc => (
            <div class="bg-white rounded-xl border border-slate-200 shadow-xs hover:shadow-md transition-all flex flex-col justify-between overflow-hidden group">
              <div class="p-6">
                <!-- Top Badges -->
                <div class="flex items-center justify-between gap-2 mb-3">
                  <span class="text-[11px] font-mono font-medium px-2 py-0.5 rounded bg-slate-100 text-slate-700 border border-slate-200">
                    {calc.engineType}
                  </span>
                  <span class="inline-flex items-center gap-1 text-[11px] font-mono text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200 font-semibold">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                    2026 Verified
                  </span>
                </div>

                <!-- Calculator Title -->
                <h3 class="text-base font-bold text-slate-900 group-hover:text-emerald-600 transition-colors line-clamp-2 mb-2">
                  <a href={getPath(`/calculator/${calc.slug}/`)}>
                    {calc.title}
                  </a>
                </h3>

                <!-- Summary Description -->
                <p class="text-xs text-slate-600 line-clamp-3 leading-relaxed mb-4">
                  {calc.metaDescription}
                </p>
              </div>

              <!-- Card Footer / Link Action -->
              <div class="px-6 py-3.5 bg-slate-50 border-t border-slate-100 flex items-center justify-between text-xs">
                <span class="text-slate-500 font-mono text-[11px]">
                  {calc.guideContent.faqs.length} FAQs | 700+ Words
                </span>
                <a
                  href={getPath(`/calculator/${calc.slug}/`)}
                  class="font-semibold text-emerald-700 group-hover:text-emerald-800 flex items-center gap-1 transition-colors"
                >
                  <span>Launch Tool</span>
                  <svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              </div>
            </div>
          ))}
        </div>
      </section>
    ))}
  </div>

  <!-- Trust Attribution Strip -->
  <div class="bg-slate-100 border-t border-slate-200 py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center max-w-2xl">
      <h3 class="text-base font-bold text-slate-900 mb-2">Missing a Specific Calculator Engine?</h3>
      <p class="text-xs text-slate-600 leading-relaxed mb-4">
        Our rate audit desk continuously analyzes merchant fee schedule changes and tax law adjustments. Submit platform requests or rate discrepancies directly to our compliance review team.
      </p>
      <a
        href={getPath('/contact/')}
        class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-xs transition-colors shadow-xs"
      >
        <span>Contact Rate Audit Team</span>
        &rarr;
      </a>
    </div>
  </div>
</BaseLayout>
