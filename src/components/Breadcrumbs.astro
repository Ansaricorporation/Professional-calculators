---
import { SITE_CONFIG } from '../config/site';
import { getPath, getCanonicalUrl } from '../utils/paths';

export interface BreadcrumbItem {
  name: string;
  url: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;

const fullItems = [
  { name: 'Home', url: getCanonicalUrl('/', SITE_CONFIG.siteUrl) },
  ...items.map(item => ({
    name: item.name,
    url: item.url.startsWith('http') ? item.url : getCanonicalUrl(item.url, SITE_CONFIG.siteUrl)
  }))
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": fullItems.map((item, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": item.name,
    "item": item.url
  }))
};
---

<nav aria-label="Breadcrumb" class="py-3 text-xs text-slate-500 font-medium">
  <ol class="flex items-center flex-wrap gap-2">
    <li>
      <a href={getPath('/')} class="hover:text-emerald-700 transition-colors flex items-center gap-1">
        <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
        </svg>
        <span>Home</span>
      </a>
    </li>

    {items.map((item, index) => {
      const isLast = index === items.length - 1;
      const targetHref = item.url.startsWith('http') ? item.url : getPath(item.url);
      return (
        <li class="flex items-center gap-2">
          <svg class="w-3 h-3 text-slate-300 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
          {isLast ? (
            <span class="text-slate-900 font-semibold truncate max-w-xs sm:max-w-md" aria-current="page">
              {item.name}
            </span>
          ) : (
            <a href={targetHref} class="hover:text-emerald-700 transition-colors truncate max-w-[140px] sm:max-w-none">
              {item.name}
            </a>
          )}
        </li>
      );
    })}
  </ol>
</nav>

<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
