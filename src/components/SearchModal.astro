---
import { getAllCalculators } from '../data/calculators';
import { getPath } from '../utils/paths';

const calculators = getAllCalculators().map(c => ({
  slug: c.slug,
  title: c.title,
  category: c.category,
  description: c.metaDescription,
  url: getPath(`/calculator/${c.slug}/`)
}));
---

<div
  id="search-modal"
  class="fixed inset-0 z-50 hidden bg-slate-900/60 backdrop-blur-xs p-4 sm:p-6 md:p-20 flex justify-center items-start overflow-y-auto"
  role="dialog"
  aria-modal="true"
  aria-label="Calculator Search"
>
  <div class="bg-white rounded-xl shadow-2xl border border-slate-200 w-full max-w-2xl overflow-hidden animate-in fade-in zoom-in-95 duration-150">
    <!-- Search Bar Input Header -->
    <div class="relative flex items-center border-b border-slate-200 px-4 py-3 bg-slate-50">
      <svg class="w-5 h-5 text-slate-400 mr-3 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <input
        type="text"
        id="calc-search-input"
        class="w-full bg-transparent text-slate-900 placeholder-slate-400 text-base focus:outline-hidden"
        placeholder="Search calculators (e.g., Shopify, Etsy, YouTube, Stripe)..."
        autocomplete="off"
      />
      <button
        type="button"
        id="close-search-modal"
        class="text-slate-400 hover:text-slate-600 p-1 rounded-md text-xs font-mono uppercase bg-slate-200/60 ml-2"
        aria-label="Close search"
      >
        ESC
      </button>
    </div>

    <!-- Results Container -->
    <div id="search-results-list" class="max-h-96 overflow-y-auto p-3 divide-y divide-slate-100">
      <!-- Populated dynamically by script -->
    </div>

    <!-- Quick Hints Footer -->
    <div class="px-4 py-2.5 bg-slate-100/80 border-t border-slate-200 flex items-center justify-between text-xs text-slate-500">
      <span>Use <kbd class="bg-white px-1.5 py-0.5 rounded border border-slate-300 font-mono text-[10px]">↑</kbd> <kbd class="bg-white px-1.5 py-0.5 rounded border border-slate-300 font-mono text-[10px]">↓</kbd> to navigate</span>
      <span class="font-medium text-emerald-700">2026 Verified Calculations</span>
    </div>
  </div>
</div>

<script define:vars={{ calculators }}>
  const modal = document.getElementById('search-modal');
  const openButtons = document.querySelectorAll('#global-search-btn');
  const closeButton = document.getElementById('close-search-modal');
  const searchInput = document.getElementById('calc-search-input');
  const resultsContainer = document.getElementById('search-results-list');

  function openModal() {
    if (!modal) return;
    modal.classList.remove('hidden');
    setTimeout(() => searchInput?.focus(), 50);
    renderResults(searchInput?.value || '');
  }

  function closeModal() {
    if (!modal) return;
    modal.classList.add('hidden');
    if (searchInput) searchInput.value = '';
  }

  function renderResults(query) {
    if (!resultsContainer) return;
    const cleanQuery = query.toLowerCase().trim();
    
    const filtered = calculators.filter(c => 
      c.title.toLowerCase().includes(cleanQuery) ||
      c.description.toLowerCase().includes(cleanQuery) ||
      c.category.toLowerCase().includes(cleanQuery) ||
      c.slug.toLowerCase().includes(cleanQuery)
    );

    if (filtered.length === 0) {
      resultsContainer.innerHTML = `
        <div class="p-6 text-center text-slate-500">
          <p class="font-medium text-slate-700">No calculators matching "${query}"</p>
          <p class="text-xs text-slate-400 mt-1">Try searching for Shopify, Etsy, YouTube RPM, or Margins.</p>
        </div>
      `;
      return;
    }

    resultsContainer.innerHTML = filtered.map(c => `
      <a href="${c.url}" class="block p-3 rounded-lg hover:bg-emerald-50/80 transition-colors group">
        <div class="flex items-center justify-between">
          <span class="font-semibold text-slate-900 group-hover:text-emerald-700 text-sm">${c.title}</span>
          <span class="text-[11px] font-mono uppercase bg-slate-100 text-slate-600 px-2 py-0.5 rounded group-hover:bg-emerald-100 group-hover:text-emerald-800">${c.category}</span>
        </div>
        <p class="text-xs text-slate-500 line-clamp-1 mt-1">${c.description}</p>
      </a>
    `).join('');
  }

  openButtons.forEach(btn => btn.addEventListener('click', openModal));
  closeButton?.addEventListener('click', closeModal);

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });

  searchInput?.addEventListener('input', (e) => {
    renderResults(e.target.value);
  });

  window.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      if (modal?.classList.contains('hidden')) {
        openModal();
      } else {
        closeModal();
      }
    }
    if (e.key === 'Escape' && !modal?.classList.contains('hidden')) {
      closeModal();
    }
  });
</script>
