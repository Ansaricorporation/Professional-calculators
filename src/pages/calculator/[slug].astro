---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import EEATAttribution from '../../components/EEATAttribution.astro';
import PlatformProfitEngine from '../../components/calculators/PlatformProfitEngine.astro';
import YouTubeRpmEngine from '../../components/calculators/YouTubeRpmEngine.astro';
import PlatformVsPlatformEngine from '../../components/calculators/PlatformVsPlatformEngine.astro';
import ShippingCostEngine from '../../components/calculators/ShippingCostEngine.astro';
import MarkupMarginEngine from '../../components/calculators/MarkupMarginEngine.astro';
import { SITE_CONFIG } from '../../config/site';
import { getAllCalculators, getRelatedCalculators } from '../../data/calculators';
import type { CalculatorDefinition } from '../../data/schema';
import { getPath, getCanonicalUrl } from '../../utils/paths';

export function getStaticPaths() {
  const allCalculators = getAllCalculators();
  return allCalculators.map(calc => ({
    params: { slug: calc.slug },
    props: { calc }
  }));
}

interface Props {
  calc: CalculatorDefinition;
}

const { calc } = Astro.props;
const categoryInfo = SITE_CONFIG.categories[calc.category];
const allCalculators = getAllCalculators();
const relatedCalculators = getRelatedCalculators(calc.slug);

// Deterministic category neighbors for 6-item comparison mesh
const sameCategory = allCalculators.filter(c => c.category === calc.category);
const currentIdx = sameCategory.findIndex(c => c.slug === calc.slug);
const neighbor1 = sameCategory[(currentIdx + 1) % sameCategory.length];
const neighbor2 = sameCategory[(currentIdx + 2) % sameCategory.length];

const combinedRelated = [...relatedCalculators, neighbor1, neighbor2]
  .filter((c, idx, arr) => c && c.slug !== calc.slug && arr.findIndex(t => t.slug === c.slug) === idx);

let fillOffset = 3;
while (combinedRelated.length < 6 && fillOffset < sameCategory.length) {
  const candidate = sameCategory[(currentIdx + fillOffset) % sameCategory.length];
  if (candidate && candidate.slug !== calc.slug && !combinedRelated.some(c => c.slug === candidate.slug)) {
    combinedRelated.push(candidate);
  }
  fillOffset++;
}
const finalRelated = combinedRelated.slice(0, 6);

const breadcrumbItems = [
  { name: categoryInfo.name, url: getPath(`/category/${calc.category}/`) },
  { name: calc.title, url: getPath(`/calculator/${calc.slug}/`) }
];

const homeUrl = getCanonicalUrl('/', SITE_CONFIG.siteUrl);
const categoryUrl = getCanonicalUrl(`/category/${calc.category}/`, SITE_CONFIG.siteUrl);
const canonicalPageUrl = getCanonicalUrl(`/calculator/${calc.slug}/`, SITE_CONFIG.siteUrl);
const ogImageUrl = getCanonicalUrl(`/og/${calc.slug}.png`, SITE_CONFIG.siteUrl);
const pinImageUrl = getCanonicalUrl(`/pins/${calc.slug}.png`, SITE_CONFIG.siteUrl);
const pinterestShareUrl = `https://pinterest.com/pin/create/button/?url=${encodeURIComponent(canonicalPageUrl)}&media=${encodeURIComponent(pinImageUrl)}&description=${encodeURIComponent(calc.title + ' - 2026 Fee Schedule & Unit Economics Cheat Sheet')}`;

// Unified @graph JSON-LD Schema (WebApplication, FAQPage, BreadcrumbList)
const schemaGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["WebApplication", "SoftwareApplication"],
      "@id": `${canonicalPageUrl}#software`,
      "name": calc.title,
      "url": canonicalPageUrl,
      "applicationCategory": "FinanceApplication",
      "operatingSystem": "Web Browser",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "description": calc.metaDescription,
      "publisher": {
        "@type": "Organization",
        "name": SITE_CONFIG.siteName,
        "url": homeUrl,
        "logo": getCanonicalUrl('/favicon.svg', SITE_CONFIG.siteUrl)
      }
    },
    {
      "@type": "FAQPage",
      "@id": `${canonicalPageUrl}#faq`,
      "mainEntity": calc.guideContent.faqs.map(faq => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.answer
        }
      }))
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonicalPageUrl}#breadcrumb`,
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": homeUrl
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": categoryInfo.name,
          "item": categoryUrl
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": calc.title,
          "item": canonicalPageUrl
        }
      ]
    }
  ]
};
---

<BaseLayout
  title={calc.title}
  metaTitle={calc.metaTitle}
  description={calc.metaDescription}
  canonicalPath={`/calculator/${calc.slug}/`}
  ogImage={ogImageUrl}
  schemaGraph={schemaGraph}
  lastUpdated={calc.lastUpdated}
>
  <!-- Calculator Header -->
  <div class="bg-white border-b border-slate-200">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <Breadcrumbs items={breadcrumbItems} skipSchema={true} />
      
      <div class="mt-3 flex flex-wrap items-center gap-2">
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800">
          2026 Fee Schedule Verified
        </span>
        <span class="text-xs text-slate-500 font-medium">Last Audited: {calc.lastUpdated}</span>
        <span class="text-xs text-slate-400">&bull;</span>
        <span class="text-xs text-slate-500 font-mono uppercase">{categoryInfo.name}</span>
      </div>

      <h1 class="mt-3 text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 tracking-tight">
        {calc.title}
      </h1>
      <p class="mt-2 text-sm sm:text-base text-slate-600 leading-relaxed max-w-3xl">
        {calc.metaDescription}
      </p>

      <!-- Institutional E-E-A-T Attribution Box -->
      <EEATAttribution
        lastUpdated={calc.lastUpdated}
        officialSourceName={calc.officialSourceName}
        officialSourceUrl={calc.officialSourceUrl}
      />
    </div>
  </div>

  <!-- Main Calculator Body & 7-Block Content Architecture -->
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-12">

    <!-- BLOCK 1: Dynamic Interactive Calculator Engine Matching engineType -->
    <section id="interactive-tool">
      {calc.engineType === 'platform-profit' && <PlatformProfitEngine calc={calc} />}
      {calc.engineType === 'youtube-rpm' && <YouTubeRpmEngine calc={calc} />}
      {calc.engineType === 'platform-vs-platform' && <PlatformVsPlatformEngine calc={calc} />}
      {calc.engineType === 'shipping-cost' && <ShippingCostEngine calc={calc} />}
      {calc.engineType === 'markup-margin' && <MarkupMarginEngine calc={calc} />}
    </section>

    <!-- Social & Visual Cheat-Sheet Share Utility Bar -->
    <div class="bg-slate-900 text-white rounded-2xl p-5 sm:p-6 border border-slate-800 shadow-md flex flex-col md:flex-row items-center justify-between gap-5">
      <div class="flex items-center gap-3.5 w-full md:w-auto">
        <div class="w-10 h-10 rounded-xl bg-emerald-500/15 border border-emerald-500/30 flex items-center justify-center text-emerald-400 shrink-0">
          <svg class="w-5 h-5" width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
          </svg>
        </div>
        <div>
          <h3 class="text-sm sm:text-base font-bold text-white tracking-tight">Share & Save This Calculator</h3>
          <p class="text-xs text-slate-400">Copy live calculations or pin the high-resolution 2026 fee cheat-sheet.</p>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-2.5 w-full md:w-auto justify-start md:justify-end">
        <!-- Copy Direct Link Button -->
        <button
          type="button"
          id="copy-link-btn"
          data-url={canonicalPageUrl}
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 hover:text-white text-xs font-semibold border border-slate-700 transition-all cursor-pointer shadow-xs active:scale-95"
        >
          <svg id="copy-icon" class="w-4 h-4 text-emerald-400" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
          <span id="copy-label">Copy Direct Link</span>
        </button>

        <!-- Pin Fee Cheat-Sheet Button -->
        <a
          href={pinterestShareUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-rose-600 hover:bg-rose-700 text-white text-xs font-semibold transition-all shadow-xs active:scale-95"
        >
          <svg class="w-4 h-4 fill-current" width="16" height="16" viewBox="0 0 24 24">
            <path d="M12 0C5.373 0 0 5.372 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738.098.119.112.224.083.345-.09.375-.293 1.199-.334 1.366-.053.225-.177.273-.409.165-1.53-.712-2.486-2.947-2.486-4.744 0-3.864 2.809-7.413 8.098-7.413 4.252 0 7.556 3.03 7.556 7.079 0 4.225-2.664 7.625-6.361 7.625-1.242 0-2.409-.646-2.808-1.409l-.765 2.918c-.277 1.066-1.025 2.402-1.528 3.221C10.279 23.834 11.127 24 12 24c6.627 0 12-5.373 12-12 0-6.628-5.373-12-12-12z"/>
          </svg>
          <span>Pin Cheat-Sheet</span>
        </a>

        <!-- View 1000x1500 Infographic Image -->
        <a
          href={pinImageUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white text-xs font-semibold border border-slate-700 transition-all shadow-xs"
          title="Open high-res 1000x1500 Pinterest infographic"
        >
          <svg class="w-4 h-4 text-emerald-400" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <span>1000&times;1500 Pin</span>
        </a>
      </div>
    </div>

    <!-- Client-side script for Copy Link interaction -->
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        const copyBtn = document.getElementById('copy-link-btn');
        const copyLabel = document.getElementById('copy-label');
        if (copyBtn && copyLabel) {
          copyBtn.addEventListener('click', async () => {
            const url = copyBtn.getAttribute('data-url');
            if (url) {
              try {
                await navigator.clipboard.writeText(url);
                const originalText = copyLabel.textContent;
                copyLabel.textContent = 'Copied to Clipboard!';
                copyBtn.classList.remove('bg-slate-800', 'text-slate-200');
                copyBtn.classList.add('bg-emerald-600', 'text-white');
                setTimeout(() => {
                  copyLabel.textContent = originalText;
                  copyBtn.classList.remove('bg-emerald-600', 'text-white');
                  copyBtn.classList.add('bg-slate-800', 'text-slate-200');
                }, 2200);
              } catch (err) {
                console.warn('Clipboard write failed:', err);
              }
            }
          });
        }
      });
    </script>

    <!-- BLOCK 2: Executive Summary (Minimum 120 words) -->
    <section class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 shadow-xs">
      <div class="max-w-3xl">
        <span class="text-xs font-mono uppercase tracking-wider text-emerald-700 font-bold bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200">
          Executive Financial Summary
        </span>
        <h2 class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight mt-2">
          Deconstructing Financial Realities in 2026
        </h2>
        <p class="mt-4 text-slate-700 leading-relaxed text-sm sm:text-base">
          {calc.guideContent.executiveSummary}
        </p>
      </div>
    </section>

    <!-- BLOCK 3: Exact Mathematical Formula Block -->
    <section class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 shadow-xs">
      <div class="max-w-3xl">
        <span class="text-xs font-mono uppercase tracking-wider text-emerald-700 font-bold bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200">
          Deterministic Mathematical Specification
        </span>
        <h2 class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight mt-2">
          Exact Mathematical Formula & Logic
        </h2>
        <p class="mt-2 text-slate-600 text-xs sm:text-sm">
          Unlike simplistic estimates, our algorithmic engine calculates net profit by computing discrete operational friction variables:
        </p>
      </div>

      <!-- Formula Container -->
      <div class="mt-6 p-4 sm:p-6 bg-slate-900 text-emerald-400 font-mono rounded-xl text-xs sm:text-sm overflow-x-auto shadow-inner leading-relaxed">
        {calc.guideContent.formulaBreakdown.formulaString}
      </div>

      <!-- Variable Definitions Legend -->
      <div class="mt-6">
        <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wider mb-3">Formula Variable Legend</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
          {calc.guideContent.formulaBreakdown.variables.map(v => (
            <div class="bg-slate-50 p-3.5 rounded-lg border border-slate-200">
              <span class="font-bold font-mono text-emerald-800">{v.symbol}</span>
              <p class="text-slate-600 mt-1 leading-relaxed">{v.meaning}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- BLOCK 4: Real-World Worked Scenario -->
    <section class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 shadow-xs">
      <div class="max-w-3xl">
        <span class="text-xs font-mono uppercase tracking-wider text-emerald-700 font-bold bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200">
          Empirical Case Study
        </span>
        <h2 class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight mt-2">
          {calc.guideContent.workedExample.scenarioTitle}
        </h2>
        <p class="mt-3 text-slate-700 text-sm leading-relaxed">
          {calc.guideContent.workedExample.narrative}
        </p>
      </div>

      <!-- Step-by-Step Breakdown -->
      <div class="mt-6 space-y-3">
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500">Step-by-Step Mathematical Reconciliation</h3>
        <div class="space-y-2">
          {calc.guideContent.workedExample.stepByStepMath.map(step => (
            <div class="flex items-start gap-3 p-3 rounded-lg bg-slate-50 border border-slate-200/80 text-xs sm:text-sm text-slate-800">
              <span class="text-emerald-700 font-bold font-mono shrink-0">&bull;</span>
              <span>{step}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Final Takeaway Box -->
      <div class="mt-6 p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-xs sm:text-sm text-emerald-950">
        <strong class="font-bold">Analyst Takeaway:</strong> {calc.guideContent.workedExample.finalTakeaway}
      </div>
    </section>

    <!-- BLOCK 5: Official 2026 Fee / Benchmark Comparison Table -->
    <section class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 shadow-xs">
      <div class="max-w-3xl mb-6">
        <span class="text-xs font-mono uppercase tracking-wider text-emerald-700 font-bold bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200">
          Official Benchmark Matrix
        </span>
        <h2 class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight mt-2">
          {calc.guideContent.benchmarkTable.title}
        </h2>
        <p class="text-xs text-slate-500 mt-1">
          Directly audited against published 2026 Merchant Agreements & Terms
        </p>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs border-collapse">
          <thead>
            <tr class="bg-slate-100 border-b border-slate-300">
              {calc.guideContent.benchmarkTable.headers.map(h => (
                <th class="p-3.5 font-bold text-slate-900 uppercase tracking-wider">{h}</th>
              ))}
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200 font-mono text-slate-700">
            {calc.guideContent.benchmarkTable.rows.map((row, idx) => (
              <tr class={idx % 2 === 0 ? 'bg-white' : 'bg-slate-50/60'}>
                {row.map((cell, cIdx) => (
                  <td class={`p-3.5 ${cIdx === 0 ? 'font-bold text-slate-900 font-sans' : ''}`}>
                    {cell}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- BLOCK 6: Strategic Margin Optimization Guide -->
    <section class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 shadow-xs">
      <div class="max-w-3xl mb-6">
        <span class="text-xs font-mono uppercase tracking-wider text-emerald-700 font-bold bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200">
          Strategic Playbook
        </span>
        <h2 class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight mt-2">
          Actionable Levers to Expand Net Margins
        </h2>
        <p class="text-xs text-slate-500 mt-1">
          Tactical interventions designed by our financial modeling desk to defend cash flows.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {calc.guideContent.optimizationLevers.map((lever, idx) => (
          <div class="p-5 rounded-xl border border-slate-200 bg-slate-50/50 hover:bg-white hover:border-emerald-500 hover:shadow-xs transition-all">
            <div class="flex items-center gap-2 mb-2">
              <span class="w-6 h-6 rounded-full bg-emerald-600 text-white font-mono text-xs font-bold flex items-center justify-center">
                {idx + 1}
              </span>
              <h3 class="font-bold text-slate-900 text-sm">{lever.title}</h3>
            </div>
            <p class="text-xs text-slate-600 leading-relaxed">
              {lever.actionableAdvice}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- BLOCK 7: 5 Unique FAQs (50+ words per answer) -->
    <section class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 shadow-xs">
      <div class="max-w-3xl mb-6">
        <span class="text-xs font-mono uppercase tracking-wider text-emerald-700 font-bold bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200">
          Industry Inquiries & Answers
        </span>
        <h2 class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight mt-2">
          Frequently Asked Questions
        </h2>
        <p class="text-xs text-slate-500 mt-1">
          Detailed technical answers addressing 2026 fee policy adjustments.
        </p>
      </div>

      <div class="divide-y divide-slate-200">
        {calc.guideContent.faqs.map(faq => (
          <div class="py-5">
            <h3 class="text-sm font-bold text-slate-900 flex items-start gap-2">
              <span class="text-emerald-700 font-mono">Q:</span>
              <span>{faq.question}</span>
            </h3>
            <p class="mt-2 text-xs sm:text-sm text-slate-600 leading-relaxed pl-6">
              {faq.answer}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- Cross-Linking: Compare Related Calculators (6-Item Anchor Mesh) -->
    {finalRelated.length > 0 && (
      <section class="border-t border-slate-200 pt-8">
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-base sm:text-lg font-bold text-slate-900 tracking-tight">Compare Related Calculators</h3>
          <span class="text-xs font-mono text-emerald-700 bg-emerald-50 px-2.5 py-0.5 rounded border border-emerald-200 font-semibold">
            {categoryInfo.name} Models
          </span>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {finalRelated.map(rel => (
            <a
              href={getPath(`/calculator/${rel.slug}/`)}
              class="p-4 rounded-xl border border-slate-200 bg-white hover:border-emerald-500 hover:shadow-xs transition-all group flex flex-col justify-between"
            >
              <div>
                <div class="text-xs font-bold text-slate-900 group-hover:text-emerald-700 transition-colors">{rel.title}</div>
                <div class="text-[11px] text-slate-500 line-clamp-2 mt-1.5 leading-relaxed">{rel.metaDescription}</div>
              </div>
              <div class="mt-3 text-[11px] font-semibold text-emerald-700 group-hover:text-emerald-800 flex items-center gap-1">
                <span>Compare Rates &rarr;</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

  </div>
</BaseLayout>
