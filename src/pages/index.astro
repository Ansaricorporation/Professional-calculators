---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_CONFIG } from '../config/site';
import { getAllCalculators } from '../data/calculators';
import { getPath } from '../utils/paths';

const calculators = getAllCalculators();
const categories = Object.values(SITE_CONFIG.categories);

// Top 16 Highest-CPC 2026 Calculators (4 per Cluster) for 1-Click Homepage Equity
const top16Slugs = [
  'shopify-profit-margin-calculator',
  'etsy-fee-calculator',
  'amazon-fba-vs-fbm-profit-calculator',
  'tiktok-shop-fee-calculator',
  'youtube-shorts-vs-long-form-calculator',
  'youtube-finance-rpm-calculator',
  'patreon-vs-kofi-calculator',
  'tiktok-creativity-program-calculator',
  'gumroad-vs-lemon-squeezy-fee-calculator',
  'stripe-vs-paypal-fee-calculator',
  'apple-app-store-vs-google-play-fee-calculator',
  'upwork-vs-fiverr-fee-calculator',
  'freelance-hourly-rate-calculator',
  'self-employment-tax-calculator',
  's-corp-vs-llc-self-employment-tax-calculator',
  'break-even-roas-calculator'
];

const top16Calculators = top16Slugs
  .map(slug => calculators.find(c => c.slug === slug))
  .filter((c): c is NonNullable<typeof c> => Boolean(c));
---

<BaseLayout
  title="Financial Modeling Lab for Creators & Sellers"
  metaTitle="CreatorCalcLab | 2026 Profit Margin & Platform Fee Calculators"
  description="Audit net profit margins, credit card interchange fees, platform take-rates, and true unit economics across Shopify, Etsy, YouTube, Gumroad, and Stripe."
  canonicalPath="/"
>
  <!-- Hero Section -->
  <section class="relative bg-white border-b border-slate-200 overflow-hidden">
    <div class="absolute inset-0 bg-radial-at-t from-emerald-50/70 via-white to-transparent pointer-events-none"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24 relative">
      <div class="text-center max-w-3xl mx-auto">
        <!-- 2026 Audit Badge -->
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 border border-emerald-200 text-xs font-semibold text-emerald-800 mb-6 shadow-xs">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>Official 2026 Platform Fee Schedules Active</span>
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-slate-900 tracking-tight leading-tight">
          Precision Financial Models for <span class="text-emerald-700">Digital Operators</span>
        </h1>

        <p class="mt-6 text-lg sm:text-xl text-slate-600 leading-relaxed font-normal">
          Unmask hidden platform take-rates, credit card interchange fees, shipping deficits, and subscription creep. Built for direct-to-consumer founders, digital creators, and independent professionals.
        </p>

        <!-- Instant Calculator Search Trigger & Shortcut -->
        <div class="mt-8 max-w-xl mx-auto">
          <button
            type="button"
            id="global-search-btn"
            class="w-full flex items-center justify-between px-5 py-4 rounded-xl border border-slate-300 bg-white shadow-sm hover:border-emerald-500 hover:shadow-md transition-all text-slate-400 group text-left"
          >
            <div class="flex items-center gap-3">
              <svg class="w-5 h-5 text-slate-400 group-hover:text-emerald-600 transition-colors" width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
              <span class="text-slate-600 text-sm font-medium group-hover:text-slate-900">
                Search calculators (e.g. Shopify, Etsy, YouTube RPM, Gumroad)...
              </span>
            </div>
            <kbd class="hidden sm:inline-block bg-slate-100 text-slate-600 px-2 py-1 rounded text-xs font-mono border border-slate-200">Ctrl K</kbd>
          </button>
        </div>

        <!-- Metric Proof Points -->
        <div class="mt-10 pt-8 border-t border-slate-100 grid grid-cols-2 sm:grid-cols-4 gap-4 text-center">
          <div>
            <div class="text-2xl font-extrabold text-slate-900 font-mono">100%</div>
            <div class="text-xs text-slate-500 font-medium mt-0.5">Static Pre-Rendered</div>
          </div>
          <div>
            <div class="text-2xl font-extrabold text-slate-900 font-mono">0 Server</div>
            <div class="text-xs text-slate-500 font-medium mt-0.5">Data Storage (Client-Side)</div>
          </div>
          <div>
            <div class="text-2xl font-extrabold text-emerald-700 font-mono">2026</div>
            <div class="text-xs text-slate-500 font-medium mt-0.5">Audited Fee Rates</div>
          </div>
          <div>
            <div class="text-2xl font-extrabold text-slate-900 font-mono">Direct</div>
            <div class="text-xs text-slate-500 font-medium mt-0.5">Rate-Card Audited</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Category Clusters Showcase -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
        Explore Calculators by Business Model
      </h2>
      <p class="mt-2 text-slate-600 text-sm sm:text-base">
        Select your operational sector to model platform deductibles, break-even thresholds, and unit margin economics.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {categories.map(cat => (
        <a
          href={getPath(`/category/${cat.id}/`)}
          class="bg-white rounded-xl border border-slate-200 p-6 hover:border-emerald-500 hover:shadow-lg transition-all group flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs font-mono uppercase tracking-wider text-emerald-800 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200 font-bold">
                {cat.badge}
              </span>
              <svg class="w-5 h-5 text-slate-400 group-hover:text-emerald-600 group-hover:translate-x-0.5 transition-all" width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </div>
            <h3 class="text-lg font-bold text-slate-900 group-hover:text-emerald-700 transition-colors">
              {cat.name}
            </h3>
            <p class="mt-2 text-xs text-slate-600 leading-relaxed">
              {cat.description}
            </p>
          </div>
          <div class="mt-6 pt-3 border-t border-slate-100 text-xs font-semibold text-emerald-700 group-hover:text-emerald-800">
            View Sector Models &rarr;
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Most Searched 2026 Fee & Profit Calculators (16-Card Rapid-Access Grid) -->
  <section class="bg-white border-t border-slate-200 py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-10">
        <div>
          <span class="text-xs font-mono uppercase tracking-wider text-emerald-700 font-bold bg-emerald-50 px-2.5 py-1 rounded border border-emerald-200">
            High-Search Benchmark Models
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight mt-2">
            Most Searched 2026 Fee & Profit Calculators
          </h2>
        </div>
        <p class="text-xs text-slate-500 mt-2 sm:mt-0 font-medium">
          Instant 1-click access to top-volume models across all four platform clusters
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {top16Calculators.map(c => (
          <a
            href={getPath(`/calculator/${c.slug}/`)}
            class="p-5 rounded-xl border border-slate-200 bg-slate-50/50 hover:bg-white hover:border-emerald-500 hover:shadow-md transition-all group flex flex-col justify-between"
          >
            <div>
              <div class="flex items-center justify-between text-[11px] mb-2.5">
                <span class="font-mono text-emerald-800 bg-emerald-100/70 px-2 py-0.5 rounded font-semibold uppercase">
                  {c.category}
                </span>
                <span class="text-slate-400 font-mono text-[10px]">2026</span>
              </div>
              <h3 class="text-sm font-bold text-slate-900 group-hover:text-emerald-700 transition-colors leading-snug">
                {c.title}
              </h3>
              <p class="text-[11px] text-slate-600 line-clamp-2 mt-2 leading-relaxed">
                {c.metaDescription}
              </p>
            </div>
            <div class="mt-4 pt-3 border-t border-slate-200/60 flex items-center justify-between text-[11px] font-semibold text-emerald-700 group-hover:text-emerald-800">
              <span>Open Model</span>
              <span>&rarr;</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Featured Calculators Grid -->
  <section class="bg-slate-100/60 border-y border-slate-200 py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-10">
        <div>
          <span class="text-xs font-mono uppercase tracking-wider text-emerald-700 font-bold">Verified Production Models</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight mt-1">
            Featured Financial Calculators
          </h2>
        </div>
        <p class="text-xs text-slate-500 mt-2 sm:mt-0 font-medium">
          Continuously calibrated against 2026 merchant fee schedules
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {calculators.map(calc => (
          <div class="bg-white rounded-xl border border-slate-200 p-6 shadow-xs flex flex-col justify-between hover:border-emerald-500 hover:shadow-md transition-all">
            <div>
              <div class="flex items-center justify-between text-xs mb-3">
                <span class="font-mono text-emerald-800 bg-emerald-50 px-2 py-0.5 rounded font-semibold uppercase border border-emerald-200">
                  {calc.category}
                </span>
                <span class="text-slate-400">{calc.lastUpdated}</span>
              </div>
              <h3 class="text-lg font-bold text-slate-900 mb-2 leading-snug">
                <a href={getPath(`/calculator/${calc.slug}/`)} class="hover:text-emerald-700 transition-colors">
                  {calc.title}
                </a>
              </h3>
              <p class="text-xs text-slate-600 leading-relaxed line-clamp-3 mb-4">
                {calc.metaDescription}
              </p>
              
              <!-- Quick Benchmark Spec Preview -->
              <div class="bg-slate-50 rounded-lg p-3 text-xs space-y-1.5 font-mono text-slate-700 border border-slate-200/80 mb-4">
                <div class="flex justify-between">
                  <span class="text-slate-500">Engine Type:</span>
                  <span class="font-bold text-slate-900 uppercase">{calc.engineType}</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-slate-500">Official Source:</span>
                  <span class="font-bold text-emerald-700 truncate max-w-[170px]">{calc.officialSourceName}</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-slate-500">Audit Status:</span>
                  <span class="font-bold text-slate-900">2026 Verified</span>
                </div>
              </div>
            </div>

            <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
              <span class="text-xs text-slate-500 font-medium">7-Block Guide + Live Engine</span>
              <a
                href={getPath(`/calculator/${calc.slug}/`)}
                class="inline-flex items-center text-xs font-bold text-white bg-emerald-600 hover:bg-emerald-700 px-3 py-1.5 rounded-lg transition-colors"
              >
                Launch Model &rarr;
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Authority & E-E-A-T Verification Section -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="bg-slate-900 text-white rounded-3xl p-8 sm:p-12 border border-slate-800 shadow-xl">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <span class="text-xs font-mono uppercase tracking-wider text-emerald-400 font-bold bg-emerald-950/80 px-2.5 py-1 rounded border border-emerald-800">
            AdSense & YMYL Quality Commitment
          </span>
          <h2 class="text-3xl font-extrabold tracking-tight mt-4 text-white leading-tight">
            How We Reconcile & Verify 2026 Platform Fee Schedules
          </h2>
          <p class="mt-4 text-slate-300 text-sm leading-relaxed">
            Financial decisions made by self-employed creators, e-commerce brands, and agency owners carry direct livelihood impact. To comply with rigorous search quality guidelines, CreatorCalcLab enforces a non-negotiable verification standard:
          </p>

          <div class="mt-6 space-y-4 text-xs sm:text-sm text-slate-300">
            <div class="flex items-start gap-3">
              <div class="w-6 h-6 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center shrink-0 mt-0.5">
                &check;
              </div>
              <div>
                <strong class="text-white">Primary Document Extraction:</strong> We source fee percentages directly from published developer documentation, SEC 10-K/10-Q reports, and merchant contracts.
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div class="w-6 h-6 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center shrink-0 mt-0.5">
                &check;
              </div>
              <div>
                <strong class="text-white">Dual-Model Verification:</strong> Our financial algorithms are audited against primary documentation through independent dual-model replication and continuous regression test suites.
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div class="w-6 h-6 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center shrink-0 mt-0.5">
                &check;
              </div>
              <div>
                <strong class="text-white">7-Block Editorial Architecture:</strong> Every calculator page incorporates exhaustive mathematical proofs, worked scenarios, optimization levers, and verified FAQs.
              </div>
            </div>
          </div>

          <div class="mt-8 flex flex-wrap gap-4">
            <a
              href={getPath('/about/')}
              class="inline-flex items-center px-5 py-2.5 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-xs transition-colors"
            >
              Read Full Methodology &rarr;
            </a>
            <a
              href={getPath('/contact/')}
              class="inline-flex items-center px-5 py-2.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold text-xs border border-slate-700 transition-colors"
            >
              Submit Rate Card Update
            </a>
          </div>
        </div>

        <div class="bg-slate-950 p-6 sm:p-8 rounded-2xl border border-slate-800 text-xs space-y-4">
          <div class="flex items-center justify-between border-b border-slate-800 pb-3">
            <span class="font-mono text-slate-400 uppercase text-[11px]">Primary Benchmark Audits</span>
            <span class="text-emerald-400 font-semibold">Verified Active</span>
          </div>

          <div class="space-y-3 font-mono">
            <div class="flex justify-between items-center py-1.5 border-b border-slate-900">
              <span class="text-slate-300">Shopify Basic Plan:</span>
              <span class="text-emerald-400 font-bold">$39/mo + (2.9% + $0.30)</span>
            </div>
            <div class="flex justify-between items-center py-1.5 border-b border-slate-900">
              <span class="text-slate-300">Shopify Grow Plan:</span>
              <span class="text-emerald-400 font-bold">$105/mo + (2.7% + $0.30)</span>
            </div>
            <div class="flex justify-between items-center py-1.5 border-b border-slate-900">
              <span class="text-slate-300">Shopify Advanced Plan:</span>
              <span class="text-emerald-400 font-bold">$399/mo + (2.5% + $0.30)</span>
            </div>
            <div class="flex justify-between items-center py-1.5 border-b border-slate-900">
              <span class="text-slate-300">Etsy Transaction Cut:</span>
              <span class="text-slate-400 font-bold">6.5% + $0.20 listing</span>
            </div>
            <div class="flex justify-between items-center py-1.5 border-b border-slate-900">
              <span class="text-slate-300">YouTube Partner Rev-Share:</span>
              <span class="text-slate-400 font-bold">55% Creator / 45% Google</span>
            </div>
            <div class="flex justify-between items-center py-1.5">
              <span class="text-slate-300">IRS Self-Employment Tax:</span>
              <span class="text-slate-400 font-bold">15.3% (FICA Medicare/SS)</span>
            </div>
          </div>

          <p class="text-[11px] text-slate-500 italic pt-2">
            Audit protocol last completed November 2026 by the CreatorCalcLab Rate Audit Desk.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
